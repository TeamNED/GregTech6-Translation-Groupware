{
  "name": "@gt6tg/core",
  "version": "0.1.0",
  "private": true,
  "description": "GregTech6 翻译算法核心：配置模型、pattern 编译、匹配、输出、RPC 类型。纯 TypeScript，不依赖 UI。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "tsx scripts/generate.ts",
    "parity": "tsx scripts/check-parity.ts",
    "perf": "tsx scripts/check-perf.ts",
    "perf:compare": "tsx scripts/check-perf.ts --compare"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "~0.74.0",
    "oxlint": "~1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "~5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
