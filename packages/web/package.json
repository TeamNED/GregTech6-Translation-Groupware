{
  "name": "@gt6tg/web",
  "version": "0.1.0",
  "private": true,
  "description": "统一 Web 控制台（Vue 3 + Naive UI）。node 托管构建用 WebSocket 调用 @gt6tg/node，纯静态构建用浏览器 Worker。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:node": "vue-tsc --noEmit && vite build --mode node",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@gt6tg/core": "workspace:*",
    "@gt6tg/runtime": "workspace:*",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "oxfmt": "~0.74.0",
    "oxlint": "~1.89.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
