{
  "name": "@gt6tg/node",
  "version": "0.1.0",
  "private": true,
  "description": "Node 适配层：本地 WebSocket RPC 开发服务、CLI 门禁、文件系统与生成物。只绑定 127.0.0.1。",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "generate": "tsx src/cli/generate.ts",
    "lint:config": "tsx src/cli/lint.ts",
    "parity": "tsx src/cli/check-parity.ts",
    "hash": "tsx src/cli/hash.ts",
    "perf": "tsx src/cli/check-perf.ts",
    "perf:compare": "tsx src/cli/check-perf.ts --compare",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@gt6tg/core": "workspace:*",
    "@gt6tg/runtime": "workspace:*",
    "ws": "^8.18.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "oxfmt": "~0.74.0",
    "oxlint": "~1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
