{
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "never",
  "htmlWhitespaceSensitivity": "ignore",
  "vueIndentScriptAndStyle": true,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "subpath"], ["parent", "sibling", "index"], "style", "unknown"],
    "internalPattern": ["@/", "#"],
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.rush/**",
    "**/common/temp/**",
    "**/project.jsonc",
    "**/*.md",
    "**/common/scripts/**",
    "common/config/rush/repo-state.json",
    "**/CHANGELOG.json",
    "**/CHANGELOG.md"
  ]
}
